},"key":"GHHEhZJ4i0"}],"key":"DdiU7Gau5k"}],"identifier":"8b40d60a-19f2-4a21-b8d5-2189fe206ace","html_id":"8b40d60a-19f2-4a21-b8d5-2189fe206ace","key":"JJO4nEHps4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot time series of daily SNOTEL data\nfig, ax = plt.subplots()\ndf.reset_index().set_index(\"datetime\")[\"snow_depth_meters\"].plot(ax=ax)\nax.set_xlabel(\"Date\", fontsize=12)\nax.set_ylabel(\"Snow depth [m]\", fontsize=12)\nax.set_title(\"SNOTEL: Creamer's Field (1302)\", fontsize=12)\nfig.tight_layout()","key":"YdM5pr0rJZ"},{"type":"outputs","id":"A9ew7IMaa0PMk2CFyLWSI","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"935e96e0dd8b00a6b322be19227efdd1","path":"/snow-observations-cookbook/build/935e96e0dd8b00a6b322be19227efdd1.png"}}},"key":"dR9Exrql7q"}],"key":"ebkdctRSIW"}],"identifier":"ab3b73e4-721c-4813-80e6-dd906582fa45","html_id":"ab3b73e4-721c-4813-80e6-dd906582fa45","key":"KEHFzziw2F"}],"key":"u3rIH9PUj1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Terrestrial Laser Scanning","url":"/notebooks/tls-data-access","group":"Observations"}}},"domain":"http://localhost:3000"}