etime(2022, 3, 1)\nend_date = datetime(2023, 4, 1)\n\ncached_path = Path(\"data/snotel_1302_snow_depth.csv\")\n\ntry:\n    df = pt.get_daily_data(start_date, end_date, variables)\nexcept Exception as e:\n    print(f\"Live fetch failed: {e}\")\n    if cached_path.exists():\n        print(\"Loading cached data instead.\")\n        df = pd.read_csv(cached_path, index_col=0, parse_dates=True)\n    else:\n        raise RuntimeError(\"No cached data available and live fetch failed.\") from e","key":"X4BbEAbP8e"},{"type":"outputs","id":"18NxFC7fQgFqx8tOhgl0D","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Live fetch failed: 502 Server Error: Bad Gateway for url: https://wcc.sc.egov.usda.gov/awdbWebService/services?WSDL\nLoading cached data instead.\n"},"key":"kBGvLi3NCF"}],"key":"ij1lTuHU5m"}],"identifier":"0fa43a6d-2014-4e39-a128-fcfe9485ae3c","html_id":"0fa43a6d-2014-4e39-a128-fcfe9485ae3c","key":"TVvmn0d4UE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"df.head()","key":"HbrnvFyXbB"},{"type":"outputs","id":"eulPXP3gO8wcBBqNZrs4T","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":8,"metadata":{},"data":{"text/plain":{"content":"                                   site                           geometry  \\\ndatetime                                                                     \n2022-03-01 09:00:00+00:00  1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-02 09:00:00+00:00  1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-03 09:00:00+00:00  1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-04 09:00:00+00:00  1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-05 09:00:00+00:00  1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n\n                           SNOWDEPTH SNOWDEPTH_units datasource  \ndatetime                                               