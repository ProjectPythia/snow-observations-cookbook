notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot time series of daily SNOTEL data\nfig, ax = plt.subplots()\ndf.reset_index().set_index(\"datetime\")[\"snow_depth_meters\"].plot(ax=ax)\nax.set_xlabel(\"Date\", fontsize=12)\nax.set_ylabel(\"Snow depth [m]\", fontsize=12)\nax.set_title(\"SNOTEL: Creamer's Field (1302)\", fontsize=12)\nfig.tight_layout()","key":"KAhRIoifFB"},{"type":"outputs","id":"jYNctxUSV-Vwf7oLR1kfk","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"935e96e0dd8b00a6b322be19227efdd1","path":"/snow-observations-cookbook/_public/935e96e0dd8b00a6b322be19227efdd1.png"}}},"key":"a2JYDDQ9xT"}],"key":"ZqXo6ur1BW"}],"identifier":"ab3b73e4-721c-4813-80e6-dd906582fa45","html_id":"ab3b73e4-721c-4813-80e6-dd906582fa45","key":"wPlEauRpgl"}],"key":"ncSvXDd5sy"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Terrestrial Laser Scanning","url":"/notebooks/tls-data-access","group":"Observations"}}},"domain":"http://pre.render"}