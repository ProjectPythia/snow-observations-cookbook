lock","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We are going to look for active SNOTEL stations near Creamer’s Field in Fairbanks, AK. The below cells search for SNOTEL stations within 0.5 degrees latitude/longitude of the provided polygon.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rLjtGkPGv8"}],"key":"SRbqyhHHCj"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We will also go ahead and define the variables we want from the station, using ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VkWmDi4oFg"},{"type":"inlineCode","value":"SnotelPointData.ALLOWED_VARIABLES","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eF8IBcF9g0"},{"type":"text","value":". Some of the allowed variables include:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UUwDl1w1lw"}],"key":"gdXZEx5bq0"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":4,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SNOWDEPTH","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"FrmU0ewzoX"},{"type":"text","value":": Snow depth, typically in inches.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"OufxZ4hvzm"}],"key":"R7bWHg3yfv"}],"key":"pCgao4WR5Q"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SWE","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ZCwyqfdZC5"},{"type":"text","value":": Snow water equivalent, typically in inches.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"q2AQc4gZK4"}],"key":"JoaX5Y7qli"}],"key":"ep5HkJ1cHZ"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"PRECIPITATION","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"bgvmMrJ1Cs"},{"type":"text","value":": Accumulated precipitation, in inches.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"bFBJu8dtOA"}],"key":"Daj0T4wZst"}],"key":"PYwxpha3Zi"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TMP","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"fiud1ZJLHs"},{"type":"text","value":": Air temperature, in degrees Fahrenheit.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"DlJ2g57tsD"}],"key":"BJU7ohG4uT"}],"key":"Mo83FWeipo"}],"key":"h0T0bBmrlb"}],"identifier":"80d542a8-351d-4a54-9017-8ba0360fc44e","html_id":"80d542a8-351d-4a54-9017-8ba0360fc44e","key":"Q08ljaK3OK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Load FLCF lidar box from SnowEx campaigns\nsf_path = Path(\"data/cffl_lidar_box.geojson\").expanduser()\nsf = gpd.read_file(str(sf_path))\nsf[\"name\"] = [\"FLCF\"]\n\n# Load the desired variables for SNOTEL query\nvariables = [SnotelPointData.ALLOWED_VARIABLES.SNOWDEPTH]","key":"Vgoc5j947s"},{"type":"outputs","id":"qLcZHl-_YagSji9GXPNNy","children":[],"key":"RdIGXZenWd"}],"identifier":"a1eed475-6b55-4a72-b24b-bcbebb7cbd55","html_id":"a1eed475-6b55-4a72-b24b-bcbebb7cbd55","key":"GkAlDvBMIE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Find SNOTEL stations within polygon with desired variables\ntry:\n    points = SnotelPointData.points_from_geometry(sf, variables)\n    # Print nearby SNOTEL stations within 0.5 degrees of polygon\n    print(SnotelPointData.points_from_geometry(sf, variables, buffer=0.5).points)\nexcept Exception as e:\n    print(f\"Could not connect to SNOTEL API: {e}\")\n    print(\"Skipping live data fetch — likely running in a restricted network environment (e.g., CI).\")","key":"HzoOW5FspX"},{"type":"outputs","id":"_OPZyvGHR-yziZURJYCwy","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"[SnotelPointData('1302:AK:SNTL', 'Creamers Field')]\n"},"key":"Nzhf0W2U5a"}],"key":"nd3Lij9l4V"}],"identifier":"f95d9652-d7af-4497-89e5-ae5e4e9b9dd4","html_id":"f95d9652-d7af-4497-89e5-ae5e4e9b9dd4","key":"OldUoCqAA7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Looks like we have a SNOTEL station here! Note the printed output: Metloom returns the station ID number (","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yucBJnUmg1"},{"type":"inlineCode","value":"1302","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gipIyDscNE"},{"type":"text","value":"), the state it’s in (","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b23CTczan5"},{"type":"inlineCode","value":"AK","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EovrTDNXaP"},{"type":"text","value":"), and the type of weather station (","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"poBbiqdsWK"},{"type":"inlineCode","value":"SNTL","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zViRoZZKFo"},{"type":"text","value":").","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"necD10LrF0"}],"key":"XrfLUnasx2"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Let’s see where it’s located in Creamer’s Field, relative to the polyon we provided.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"b85XtfXAmn"}],"key":"YL1UQao4j1"}],"identifier":"cceaa562-252a-456a-bac3-1ade7231d799","html_id":"cceaa562-252a-456a-bac3-1ade7231d799","key":"OilTlGhWH9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot lidar box over ESRI tiles and the SNOTEL station location (if available)\nif 'points' in dir() and points is not None:\n    m = sf.explore(\n        tooltip=False, color=\"grey\", highlight=False, tiles=\"Esri.WorldImagery\",\n        style_kwds={\"opacity\": 0.2}, popup=[\"name\"]\n    )\n    # Add plot showing location of SNOTEL station(s)\n    df = points.to_dataframe()\n    df.explore(m=m, tooltip=[\"name\", \"id\"], color=\"red\", marker_kwds={\"radius\":4})\n    display(m)\nelse:\n    print(\"Skipping map — SNOTEL station data not available (API unreachable).\")\n","key":"bHPnj5Hbb4"},{"type":"outputs","id":"6zgQcFK0dWQ8nHa0npysr","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<folium.folium.Map at 0x701175b8a660>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"ee5551a2930b751faf50fb3c47c05a60","path":"/snow-observations-cookbook/_public/ee5551a2930b751faf50fb3c47c05a60.html"}}},"key":"sv7xPnTSVD"}],"key":"zMwFPympbI"}],"identifier":"df1095d2-1d69-4f59-bce6-3b9d4131e535","html_id":"df1095d2-1d69-4f59-bce6-3b9d4131e535","key":"RldD3Kp7iS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we know which SNOTEL is in the area, we can query for the data.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oqDjBiRrOW"}],"key":"e6iJMujG8E"}],"identifier":"ab37a337-143d-4adc-a40e-c89e784df097","html_id":"ab37a337-143d-4adc-a40e-c89e784df097","key":"i5V5xVPGhc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Define SNOTEL station from FLCF\npt = SnotelPointData(\"1302:AK:SNTL\", \"Creamer's Field\")","key":"Khv0ibLeGb"},{"type":"outputs","id":"zNgkOk1OMK4U6NzltA2Wh","children":[],"key":"yQB6OnmpSN"}],"identifier":"250ba2c7-2935-40b1-9795-5c1fdc7a2a3b","html_id":"250ba2c7-2935-40b1-9795-5c1fdc7a2a3b","key":"dziKKUxovq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"As with other API requests, we can subset the data with a date range, given as datetime objects.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RieO7euISB"}],"key":"BtAV6MCXgj"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Note here that we are requesting for snow depths on a daily basis. If desired, we could also obtain the hourly data instead, using ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sZ5ioz4A1e"},{"type":"inlineCode","value":"pt.get_hourly_data()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KyQGVtIqP5"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tnkrQyC4kV"}],"key":"JaDKRk34MV"}],"identifier":"521e0577-fee1-4268-be3e-e95905969099","html_id":"521e0577-fee1-4268-be3e-e95905969099","key":"MDUUBHGbjn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Start and end date of SNOTEL query\nstart_date = datetime(2022, 3, 1)\nend_date = datetime(2023, 4, 1)\n\ncached_path = Path(\"data/snotel_1302_snow_depth.csv\")\n\ntry:\n    df = pt.get_daily_data(start_date, end_date, variables)\nexcept Exception as e:\n    print(f\"Live fetch failed: {e}\")\n    if cached_path.exists():\n        print(\"Loading cached data instead.\")\n        df = pd.read_csv(cached_path, index_col=0, parse_dates=True)\n    else:\n        raise RuntimeError(\"No cached data available and live fetch failed.\") from e","key":"RNSu6WqYDg"},{"type":"outputs","id":"0ZdRunPGyQEI6fpl3gbPn","children":[],"key":"lCT9x7sdbV"}],"identifier":"0fa43a6d-2014-4e39-a128-fcfe9485ae3c","html_id":"0fa43a6d-2014-4e39-a128-fcfe9485ae3c","key":"DQNu132PSk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"df.head()","key":"kNeqjM9swP"},{"type":"outputs","id":"PxJ7Eof9lnCmD6wDJ_oGL","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":8,"metadata":{},"data":{"text/plain":{"content":"                                                                 geometry  \\\ndatetime                  site                                              \n2022-03-01 09:00:00+00:00 1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-02 09:00:00+00:00 1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-03 09:00:00+00:00 1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-04 09:00:00+00:00 1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-05 09:00:00+00:00 1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n\n                                        SNOWDEPTH SNOWDEPTH_units datasource  \ndatetime                  site                                                \n2022-03-01 09:00:00+00:00 1302:AK:SNTL       31.0              in       NRCS  \n2022-03-02 09:00:00+00:00 1302:AK:SNTL       30.0              in       NRCS  \n2022-03-03 09:00:00+00:00 1302:AK:SNTL       29.