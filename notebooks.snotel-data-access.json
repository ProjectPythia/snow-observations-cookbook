ion":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qUIn7hszwB"},{"type":"text","value":").","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BMnpYuiHyz"}],"key":"usePZcH0z8"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Let’s see where it’s located in Creamer’s Field, relative to the polyon we provided.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uuoSbHjXBe"}],"key":"OFWtFmsvCl"}],"identifier":"cceaa562-252a-456a-bac3-1ade7231d799","html_id":"cceaa562-252a-456a-bac3-1ade7231d799","key":"P0jm531f2X"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot lidar box over ESRI tiles and the SNOTEL station location (if available)\nif 'points' in dir() and points is not None:\n    m = sf.explore(\n        tooltip=False, color=\"grey\", highlight=False, tiles=\"Esri.WorldImagery\",\n        style_kwds={\"opacity\": 0.2}, popup=[\"name\"]\n    )\n    # Add plot showing location of SNOTEL station(s)\n    df = points.to_dataframe()\n    df.explore(m=m, tooltip=[\"name\", \"id\"], color=\"red\", marker_kwds={\"radius\":4})\n    display(m)\nelse:\n    print(\"Skipping map — SNOTEL station data not available (API unreachable).\")\n","key":"ttXbDTnQQm"},{"type":"outputs","id":"uovTxfzn3GK-WUp1hdsf0","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Skipping map — SNOTEL station data not available (API unreachable).\n"},"key":"mn0LAjIQ9f"}],"key":"gIrQhVH8X3"}],"identifier":"df1095d2-1d69-4f59-bce6-3b9d4131e535","html_id":"df1095d2-1d69-4f59-bce6-3b9d4131e535","key":"UvGjstwffq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we know which SNOTEL is in the area,