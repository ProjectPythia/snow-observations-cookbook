},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Convert snow depth to meters\ndf['snow_depth_meters'] = df['SNOWDEPTH']*0.0254","key":"rx1y9Ay0uu"},{"type":"outputs","id":"bvYkrs9zfjVNPwAoxLgle","children":[],"key":"Jq7wDRwA4r"}],"identifier":"3b73fe5e-1291-4f20-84f3-16ebfa004cf8","html_id":"3b73fe5e-1291-4f20-84f3-16ebfa004cf8","key":"rdXSkyYtKT"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"From there, it’s simple to plot the snow depth data as a time series.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"T5rPhuPxkJ"}],"key":"AoMcZ93XMs"}],"identifier":"8b40d60a-19f2-4a21-b8d5-2189fe206ace","html_id":"8b40d60a-19f2-4a21-b8d5-2189fe206ace","key":"AmnfTosuDa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot time series of daily SNOTEL data\nfig, ax = plt.subplots()\ndf.reset_index().set_index(\"datetime\")[\"snow_depth_meters\"].plot(ax=ax)\nax.set_xlabel(\"Date\", fontsize=12)\nax.set_ylabel(\"Snow depth [m]\", fontsize=12)\nax.set_title(\"SNOTEL: Creamer's Field (1302)\", fontsize=12)\nfig.tight_layout()","key":"lZjPlMfvYC"},{"type":"outputs","id":"RDXMM2EfuTo6J3h8g-to-","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"935e96e0dd8b00a6b322be19227efdd1","path":"/snow-observations-cookbook/build/935e96e0dd8b00a6b322be19227efdd1.png"}}},"key":"qjtxWbmeEJ"}],"key":"luf3W12Te0"}],"identifier":"ab3b73e4-721c-4813-80e6-dd906582fa45","html_id":"ab3b73e4-721c-4813-80e6-dd906582fa45","key":"SVDBcHOtqe"}],"key":"hSmJrKwAGp"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navig