lue":"# Find SNOTEL stations within polygon with desired variables\ntry:\n    points = SnotelPointData.points_from_geometry(sf, variables)\n    # Print nearby SNOTEL stations within 0.5 degrees of polygon\n    print(SnotelPointData.points_from_geometry(sf, variables, buffer=0.5).points)\nexcept Exception as e:\n    print(f\"Could not connect to SNOTEL API: {e}\")\n    print(\"Skipping live data fetch — likely running in a restricted network environment (e.g., CI).\")","key":"dfFCgo7jVo"},{"type":"outputs","id":"mgU-_ARr2dDSM36b0q4Pc","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"[SnotelPointData('1302:AK:SNTL', 'Creamers Field')]\n"},"key":"zubJjDHdVu"}],"key":"vYEdRsJ9yE"}],"identifier":"f95d9652-d7af-4497-89e5-ae5e4e9b9dd4","html_id":"f95d9652-d7af-4497-89e5-ae5e4e9b9dd4","key":"EdVmJuTfl3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Looks like we have a SNOTEL station here! Note the printed output: Metloom returns the station ID number (","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EFkWvmrrnI"},{"type":"inlineCode","value":"1302","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NeSAVVc7UN"},{"type":"text","value":"), the state it’s in (","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fzfgK4R3oH"},{"type":"inlineCode","value":"AK","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oinvCrOjFV"},{"type":"text","value":"), and the type of weather station (","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k8hVKVQ4UJ"},{"type":"inlineCode","value":"SNTL","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UuABP14vXF"},{"type":"text","value":").","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bEiVe6DHPm"}],"key":"cSXXQZYNPQ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Let’s see where it’s located in Creamer’s Field, relative to the polyon we provided.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xRXUUElxUN"}],"key":"ZutEurgjbz"}],"identifier":"cceaa562-252a-456a-bac3-1ade7231d799","html_id":"cceaa562-252a-456a-bac3-1ade7231d799","key":"j9zjkKtjQR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot lidar box over ESRI tiles and the SNOTEL station location (if available)\nif 'points' in dir() and points is not None:\n    m = sf.explore(\n        tooltip=False, color=\"grey\", highlight=False, tiles=\"Esri.WorldImagery\",\n        style_kwds={\"opacity\": 0.2}, popup=[\"name\"]\n    )\n    # Add plot showing location of SNOTEL station(s)\n    df = points.to_dataframe()\n    df.explore(m=m, tooltip=[\"name\", \"id\"], color=\"red\", marker_kwds={\"radius\":4})\n    display(m)\nelse:\n    print(\"Skipping map — SNOTEL station data not available (API unreachable).\")\n","key":"CZ6FfzOSzG"},{"type":"outputs","id":"34L6LPpmXn8zTx4sAKiPI","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<folium.folium.Map at 0x7382c5c7a900>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"25c2a1b10ea22bc5cf322b0d4e5c37b8","path":"/snow-observations-cookbook/_public/25c2a1b10ea22bc5cf322b0d4e5c37b8.html"}}},"key":"cGt7wl9Qvn"}],"key":"AAl3rELNaM"}],"identifier":"df1095d2-1d69-4f59-bce6-3b9d4131e535","html_id":"df1095d2-1d69-4f59-bce6-3b9d4131e535","key":"SShNt9rVAg"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we know which SNOTEL is in the area, we can query for the data.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a6XxPlq6VB"}],"key":"I7qwlUO2c3"}],"identifier":"ab37a337-143d-4adc-a40e-c89e784df097","html_id":"ab37a337-143d-4adc-a40e-c89e784df097","key":"pTNReoUxY2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Define SNOTEL station from FLCF\npt = SnotelPointData(\"1302:AK:SNTL\", \"Creamer's Field\")","key":"sa51DZk9Kp"},{"type":"outputs","id":"F8aaAeEeqdv5BlodJidVS","children":[],"key":"V3s6xeKIgk"}],"identifier":"250ba2c7-2935-40b1-9795-5c1fdc7a2a3b","html_id":"250ba2c7-2935-40b1-9795-5c1fdc7a2a3b","key":"zDyfhLrQUa"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"As with other API requests, we can subset the data with a date range, given as datetime objects.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MVsy22e90E"}],"key":"XM7Paunuql"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Note here that we are requesting for snow depths on a daily basis. If desired, we could also obtain the hourly data instead, using ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"w8aw2YbUKO"},{"type":"inlineCode","value":"pt.get_hourly_data()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wGAaOT4VN0"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FUDrnGKCBq"}],"key":"tPyi1ZEhaZ"}],"identifier":"521e0577-fee1-4268-be3e-e95905969099","html_id":"521e0577-fee1-4268-be3e-e95905969099","key":"zgWgfShoxY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Start and end date of SNOTEL query\nstart_date = datetime(2022, 3, 1)\nend_date = datetime(2023, 4, 1)\n\ncached_path = Path(\"data/snotel_1302_snow_depth.csv\")\n\ntry:\n    df = pt.get_daily_data(start_date, end_date, variables)\nexcept Exception as e:\n    print(f\"Live fetch failed: {e}\")\n    if cached_path.exists():\n        print(\"Loading cached data instead.\")\n        df = pd.read_csv(cached_path, index_col=0, parse_dates=True)\n    else:\n        raise RuntimeError(\"No cached data available and live fetch failed.\") from e","key":"YJ80sDhq6k"},{"type":"outputs","id":"7TOYtRwNNore1v1kaPKnd","children":[],"key":"mLOP93MlHo"}],"identifier":"0fa43a6d-2014-4e39-a128-fcfe9485ae3c","html_id":"0fa43a6d-2014-4e39-a128-fcfe9485ae3c","key":"YFdtcGF6Re"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"df.head()","key":"rMli3A05pS"},{"type":"outputs","id":"pL2VLfhX4_D7tnDJmxGqy","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":8,"metadata":{},"data":{"text/plain":{"content":"                                                                 geometry  \\\ndatetime                  site                                              \n2022-03-01 09:00:00+00:00 1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-02 09:00:00+00:00 1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-03 09:00:00+00:00 1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-04 09:00:00+00:00 1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n2022-03-05 09:00:00+00:00 1302:AK:SNTL  POINT Z (-147.73617 64.86534 440)   \n\n                                        SNOWDEPTH SNOWDEPTH_units datasource  \ndatetime                  site                                                \n2022-03-01 09:00:00+00:00 1302:AK:SNTL       31.0              in       NRCS  \n2022-03-02 09:00:00+00:00 1302:AK:SNTL       30.0              in       NRCS  \n2022-03-03 09:00:00+00:00 1302:AK:SNTL       29.