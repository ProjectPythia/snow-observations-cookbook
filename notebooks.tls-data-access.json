{"version":3,"kind":"Notebook","sha256":"3e5ee563947dc9e702cfdd3abb993e2c2c30acf43623b44d9fa81b27bead7851","slug":"notebooks.tls-data-access","location":"/notebooks/tls_data_access.ipynb","dependencies":[],"frontmatter":{"title":"Terrestrial Laser Scanning","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"The NASA Snow Observations Community","given":"The NASA Snow Observations","family":"Community"},"name":"The NASA Snow Observations Community","id":"contributors-myst-generated-uid-0"}],"open_access":true,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","free":true,"osi":true}},"github":"https://github.com/SnowEx/snow-observations-cookbook","copyright":"2025","affiliations":[{"id":"UAlbany","name":"University at Albany (SUNY)","department":"Atmospheric and Environmental Sciences","url":"https://www.albany.edu/daes"},{"id":"CISL","name":"NSF National Center for Atmospheric Research","department":"Computational and Information Systems Lab","url":"https://www.cisl.ucar.edu"},{"id":"Unidata","name":"NSF Unidata","url":"https://www.unidata.ucar.edu"},{"id":"Argonne","name":"Argonne National Laboratory","department":"Environmental Science Division","url":"https://www.anl.gov/evs"},{"id":"CarbonPlan","name":"CarbonPlan","url":"https://carbonplan.org"},{"id":"NVIDIA","name":"NVIDIA Corporation","url":"https://www.nvidia.com/"},{"id":"2i2c","name":"2i2c","url":"https://2i2c.org"}],"numbering":{"title":{"offset":1}},"source_url":"https://github.com/SnowEx/snow-observations-cookbook/blob/main/notebooks/tls_data_access.ipynb","edit_url":"https://github.com/SnowEx/snow-observations-cookbook/edit/main/notebooks/tls_data_access.ipynb","exports":[{"format":"ipynb","filename":"tls_data_access.ipynb","url":"/snow-observations-cookbook/build/tls_data_access-d2da28d6227c757655bd3cf525540c64.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This notebook is designed to take terrestrial laser scanner (TLS) data from the SnowEx Alaska Campaigns and derive snow depth. The TLS data is provided in both a raw point cloud format and a processed DEM format. For this example, we will be focusing on the TLS DEMs.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"viNNoq830g"}],"key":"hAkDb24S1h"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The TLS data is available through the cloud on NSIDC and can be accessed using the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"LR5jJs7Jbz"},{"type":"inlineCode","value":"earthaccess","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bWHrtWj5pl"},{"type":"text","value":" package. For this tutorial, we’ll use pre-selected data hosted on S3 for simplicity, which allows the notebook to run without authentication. We’ll also show you how to access the full dataset using ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"krCYN0t6B2"},{"type":"inlineCode","value":"earthaccess","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"inWJQhJCfM"},{"type":"text","value":" if you want to explore more data on your own.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"GDy6MVx6fj"}],"key":"V7Lg3uTOz6"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The first example will involve a single TLS image for simplicity, then we will have a second example that examines multiple TLS scans from the campaigns.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"thDzChdPEL"}],"key":"dF4gS3cNqs"}],"identifier":"55d3b72c-7259-442f-a813-1b6786813c73","html_id":"55d3b72c-7259-442f-a813-1b6786813c73","key":"y8d6TqhLU5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\n\n# Prevent GDAL from probing S3 for sidecar files (.msk, .aux, etc.)\n# which would generate spurious 403 warnings. Must be set before GDAL initializes.\nos.environ['GDAL_DISABLE_READDIR_ON_OPEN'] = 'EMPTY_DIR'\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport re\nimport rioxarray as rxr\nimport xarray as xr","key":"vyuiSmLf0q"},{"type":"outputs","id":"LPw-0L8bDlchK8GaEuRvm","children":[],"key":"Cow3OXhRXg"}],"identifier":"2d61528f-612a-442d-a04a-2332adea56e4","html_id":"2d61528f-612a-442d-a04a-2332adea56e4","key":"hMBTJGfBzb"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The TLS data was gathered in Bonanza Creek near Fairbanks, AK in two months: October 2022 and March 2023. These months correspond to the snow-off and snow-on seasons, respectively. We will start by getting some sample snow-on TLS data from a single day.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E1oTtxwuDG"}],"key":"Smc6FCxu37"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Data Access","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ExDKgz808P"}],"identifier":"data-access","label":"Data Access","html_id":"data-access","implicit":true,"key":"I05V20Ihve"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For this tutorial, we’ll stream data directly from an S3 bucket, which doesn’t require authentication. If you want to access the full dataset from NSIDC using ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lYViavsufi"},{"type":"inlineCode","value":"earthaccess","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"KbSTfHjkgP"},{"type":"text","value":", see the section at the end of this notebook.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"GLZlzF2Y7P"}],"key":"RwoK7zKv2V"}],"identifier":"e4c960be-fb35-4366-b71f-080f8fd91005","html_id":"e4c960be-fb35-4366-b71f-080f8fd91005","key":"TZ8oOTOkNn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Define S3 URLs for TLS data\nS3_BASE_URL = \"https://snowex-tutorials.s3.us-west-2.amazonaws.com/tls\"\n\n# Single scan example - snow-on (March 15, 2023) and snow-off (October 25, 2022)\n# Using CRS3 site which has data from both periods\nsnow_on_url = f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20230315_CRS3_V01.0.tif\"\nsnow_off_url = f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20221025_CRS3_V01.0.tif\"\n\nprint(\"✓ S3 URLs configured for streaming TLS data\")","key":"K9cbRcyrvl"},{"type":"outputs","id":"4hl8SkcNKi-wuk5kS3zxo","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"✓ S3 URLs configured for streaming TLS data\n"},"key":"bgOe1fDWhY"}],"key":"JMBfoQxXVY"}],"identifier":"65ff49cc-6d5b-4c31-8881-a9dc913b8ba1","html_id":"65ff49cc-6d5b-4c31-8881-a9dc913b8ba1","key":"OYxqQSdi8w"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Because the TLS data is available on-demand through the cloud, we do not need to download it. Instead, we can stream it directly with ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OpKuCSWifl"},{"type":"inlineCode","value":"rioxarray","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TXtXRy0Mt4"},{"type":"text","value":"!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pvJ2ZXmm7F"}],"key":"w4zxp9ekGA"}],"identifier":"38b86078-7d41-4141-8c5a-2eef894eb02f","html_id":"38b86078-7d41-4141-8c5a-2eef894eb02f","key":"UJqhK2TdgG"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# Load a single TLS scan from S3\nsnow_on = rxr.open_rasterio(snow_on_url)","key":"BLbwxrsu9c"},{"type":"outputs","id":"Pb9PTzRq8yP2_ICmSD3DU","children":[],"key":"SooTDOLeYK"}],"identifier":"2935bddb-77bd-44a6-9f16-840954d28fb0","html_id":"2935bddb-77bd-44a6-9f16-840954d28fb0","key":"yKgveAmhdc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"snow_on.rio.width","key":"FMSRFWjGao"},{"type":"outputs","id":"gggoCGxDnGYAlardqRm9-","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"455","content_type":"text/plain"}}},"key":"pEuCS25yWU"}],"key":"K6h4IivKqD"}],"identifier":"a2842243-956e-4e4a-906c-0d3c521a9b16","html_id":"a2842243-956e-4e4a-906c-0d3c521a9b16","key":"SlcVqQzUaS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Visualize the snow-on data\nfig, ax = plt.subplots()\nsnow_on.plot(ax=ax, vmin=123, vmax=126,\n             cbar_kwargs={'label': \"Elevation [m]\"})\nax.set_xlabel(\"Easting [m]\")\nax.set_ylabel(\"Northing [m]\")\nax.set_title(\" \")","key":"HxP6ztUCCJ"},{"type":"outputs","id":"6PMp5oeHrnDuo77mOhCQW","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"245fe3aa4a1a0401b051c6e86e02d45d","path":"/snow-observations-cookbook/build/245fe3aa4a1a0401b051c6e86e02d45d.png"}}},"key":"mOrIefQfZu"}],"key":"dCerng0Qiw"}],"identifier":"5e49cfef-3705-47ff-84fa-02e3e3f607f7","html_id":"5e49cfef-3705-47ff-84fa-02e3e3f607f7","key":"asfGjxFDJU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Two things are noticeable from this TLS data:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jBchIgPv2D"}],"key":"dfHxejYmnp"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It has a very high resolution (0.15 m).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"bY1kejIZQn"}],"key":"jkHKLmjFml"}],"key":"Pfyz2r7BsH"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The signal attenutates after ~60 m, so we have a small field of view.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"A46cP3wzeJ"}],"key":"v1maIEME63"}],"key":"f9YBkCXZND"}],"key":"gcJCoKNQNI"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This suggests that we will be able to obtain very fine-scale measurements of snow depth, but we will need scans from multiple locations to better characterize snow in Bonanza Creek.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Fr7UgKTRRf"}],"key":"xJ5Q6Sqctp"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"In any case, let’s grab the snow-off data from the same location, and try to derive snow depth.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"P3z6oxjRCb"}],"key":"iJbydjLwDv"}],"identifier":"128c4a43-dafc-433c-85f0-51f51b48bb8c","html_id":"128c4a43-dafc-433c-85f0-51f51b48bb8c","key":"BjanPDQmVQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Load the corresponding snow-off scan from S3\nsnow_off = rxr.open_rasterio(snow_off_url)","key":"u0SednGE4s"},{"type":"outputs","id":"IJQAE0oNmFWcJWu_bZsyz","children":[],"key":"WyroRpZe1t"}],"identifier":"5f490497-d462-4ecb-9917-2b9216a713fc","html_id":"5f490497-d462-4ecb-9917-2b9216a713fc","key":"wzKfC2eEGC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots()\nsnow_off.plot(vmin=123, vmax=126,\n              cbar_kwargs={'label': \"Elevation [m]\"})\nax.set_xlabel(\"Easting [m]\")\nax.set_ylabel(\"Northing [m]\")\nax.set_title(\" \")","key":"bb8QehHdJD"},{"type":"outputs","id":"edDVBVxdRD8K5RzmySGkJ","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"c023c4d10f3d3d57d8317f01ad915c3b","path":"/snow-observations-cookbook/build/c023c4d10f3d3d57d8317f01ad915c3b.png"}}},"key":"KqxEeIv1E5"}],"key":"e1oK2HgOWX"}],"identifier":"4c68c4e2-3d4e-4224-b289-ee234f3e7fcb","html_id":"4c68c4e2-3d4e-4224-b289-ee234f3e7fcb","key":"ia7MTon4oS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Although the snow-on/-off data look similar to each other, there are slight differences, meaning that we cannot perform a difference right away. We must first interpolate the data, ensuring that fill values are accounted for, then perform the difference.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DNhMHaP6JU"}],"key":"UJ4oQKhLBd"}],"identifier":"bd3898fa-8e20-46e2-9084-f5b58d033215","html_id":"bd3898fa-8e20-46e2-9084-f5b58d033215","key":"R5WSSqjhGB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Interpolate snow-on data onto the x/y grid of snow-off data\nsnow_on_interp = snow_on.interp(\n    x=snow_off.x,\n    y=snow_off.y,\n    kwargs={\"fill_value\": snow_on.attrs.get('_FillValue', np.nan)}\n)\n\n# Calculate the difference (snow depth)\ndifference = snow_on_interp - snow_off\n\n# Define fill values in data\nfill = snow_off.attrs.get('_FillValue', -9999.0)\n\n# Include only data that is not equal to the fill value\ndifference = difference.where((snow_off != fill) & (snow_on_interp != fill))","key":"RE3IaStAVV"},{"type":"outputs","id":"HAmY8CxxtbZEZjbQwFHxy","children":[],"key":"Kw7JiLoTIA"}],"identifier":"d8d349b6-dc6f-4fcf-be67-661ae311eab1","html_id":"d8d349b6-dc6f-4fcf-be67-661ae311eab1","key":"m0KkkaJvw9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot snow depth over the TLS scene\nfig, ax = plt.subplots()\ndifference.plot(vmin=0, vmax=1.5,\n                cbar_kwargs={'label': \"Snow depth [m]\"})\nax.set_xlabel(\"Easting [m]\")\nax.set_ylabel(\"Northing [m]\")\nax.set_title(\" \")","key":"VmJOvN5Isc"},{"type":"outputs","id":"16wAA33X4h2os4Gq7Lce3","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"045cbb8d973b24504a93387cca9090dd","path":"/snow-observations-cookbook/build/045cbb8d973b24504a93387cca9090dd.png"}}},"key":"Wn6KXgvj2o"}],"key":"nE908Ext6V"}],"identifier":"ba3e3d08-0d1d-48b1-bfe4-75a27946d603","html_id":"ba3e3d08-0d1d-48b1-bfe4-75a27946d603","key":"sAhEavFGuZ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Although not perfect, this provides a very reasonable snow depth DEM for the TLS data gathered in this location. If we want, we can perform basic statistics on the derived snow depths.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yRlNeFO9lb"}],"key":"P36bD0MFt6"}],"identifier":"716ed774-1466-4443-bf04-6ab839df4925","html_id":"716ed774-1466-4443-bf04-6ab839df4925","key":"ERosF0SpIY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Calculate median snow depth over the scene\nmedian_depth = difference.where(difference>=0).median()\n\n# Make histogram plot of snow depth\nfig, ax = plt.subplots()\ndifference.where(difference>=0).plot.hist(ax=ax, bins=50)\nax.axvline(x=median_depth, color='black', linewidth=2, linestyle='--') # Median depth line\nax.set_xlim([0, 2.5])\nax.set_ylabel(\"Counts\")\nax.set_xlabel(\"Snow depth [m]\")\nax.set_title(' ')\nax.text(1, 8000, f'Median depth = {median_depth:.2f} m', fontsize=12)","key":"AoASoWJTf0"},{"type":"outputs","id":"Z_HNDpFbBLuwuedxy0hEr","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"36aa2046d82e554fdb9d5e19ca265e7b","path":"/snow-observations-cookbook/build/36aa2046d82e554fdb9d5e19ca265e7b.png"}}},"key":"TKZaiKbc3D"}],"key":"QiAIkhHveH"}],"identifier":"55b293a7-79e5-4c72-9a2d-6d9c7c7a44cb","html_id":"55b293a7-79e5-4c72-9a2d-6d9c7c7a44cb","key":"k6NtjMkj0b"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Multiple Scans Example","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NDYr6x5CHd"}],"identifier":"multiple-scans-example","label":"Multiple Scans Example","html_id":"multiple-scans-example","implicit":true,"key":"Ux1VGZP9Vs"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"For the multiple scans example, we’ll work with data from several sites across Bonanza Creek. The files are pre-selected and hosted on S3 for convenient streaming without authentication.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZIej8Mnfkh"}],"key":"azCJvORhH2"}],"identifier":"cb7a1598-c662-4378-b407-38339d008e08","html_id":"cb7a1598-c662-4378-b407-38339d008e08","key":"j7Q5IdwL3p"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# Define file lists for multiple scan example\n# Using cross-section (CRS) sites and control sites (DEC, CRE) that have both snow-on and snow-off data\nsnow_on_files = [\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20230313_CRS1_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20230315_CRS2_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20230315_CRS3_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20230314_CRS4_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20230310_CRS5_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20230310_CRS6_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20230314_CRS7_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_N_20230316_DEC_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20230315_CRE_V01.0.tif\",\n]\n\nsnow_off_files = [\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20221026_CRS1_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20221026_CRS2_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20221025_CRS3_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20221025_CRS4_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20221025_CRS5_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20221024_CRS6_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20221024_CRS7_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_N_20221023_DEC_V01.0.tif\",\n    f\"{S3_BASE_URL}/SNEX23_BCEF_TLS_SW_20221027_CRE_V01.0.tif\",\n]\n\nprint(f\"Found {len(snow_on_files)} snow-on files\")\nprint(f\"Found {len(snow_off_files)} snow-off files\")","key":"nNlDHQQKnS"},{"type":"outputs","id":"fGLLJdpIKcacjI0DoveoR","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Found 9 snow-on files\nFound 9 snow-off files\n"},"key":"VHc7N5vdDv"}],"key":"WKFYcQUgpK"}],"identifier":"98e002c0-a473-45e5-b940-89218fb18d96","html_id":"98e002c0-a473-45e5-b940-89218fb18d96","key":"SMJQmABVQ3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create list of snow-on DataArrays by streaming from S3\nsnow_on_rasters = [rxr.open_rasterio(f) for f in snow_on_files]\n\n# Create list of snow-off DataArrays\nsnow_off_rasters = [rxr.open_rasterio(f) for f in snow_off_files]\n\nprint(f\"Loaded {len(snow_on_rasters)} snow-on rasters\")\nprint(f\"Loaded {len(snow_off_rasters)} snow-off rasters\")","key":"TfplOTsFNA"},{"type":"outputs","id":"qLNcDBxSqb1wNjUa7cRe_","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Loaded 9 snow-on rasters\nLoaded 9 snow-off rasters\n"},"key":"EDoeE6NVli"}],"key":"iumnt0ufUh"}],"identifier":"83f71a80-c118-48db-9790-0d0c4ca86a76","html_id":"83f71a80-c118-48db-9790-0d0c4ca86a76","key":"fBmonzMDuo"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"To make the final plot of this example cleaner, we will assign each TLS scan a label based on the site ID at Bonanza Creek.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ByyF7ob10D"}],"key":"qSnplXKhBi"}],"identifier":"ea76e66f-41ed-4b28-a947-2da627252f3f","html_id":"ea76e66f-41ed-4b28-a947-2da627252f3f","key":"S5pek2xjrO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"snon_site_ids = []\nsnoff_site_ids = []\n\n# Get site IDs for each snow-on file from URL\nfor url in snow_on_files:\n    # Extract filename from URL\n    filename = url.split('/')[-1]\n    # Use regex to extract the site ID from filename, given pattern _SW_YYYYMMDD_SITEID_V\n    m = re.search(r'_(SW|N|NE)_\\d{8}_(.*?)_V', filename)\n    if m:\n        snon_site_ids.append(m.group(2))\n    else:\n        snon_site_ids.append(\"unknown\")\n\n# Get site IDs for each snow-off file\nfor url in snow_off_files:\n    filename = url.split('/')[-1]\n    m = re.search(r'_(SW|N|NE)_\\d{8}_(.*?)_V', filename)\n    if m:\n        snoff_site_ids.append(m.group(2))\n    else:\n        snoff_site_ids.append(\"unknown\")\n\nprint(\"Snow-on site IDs:\", snon_site_ids)\nprint(\"Snow-off site IDs:\", snoff_site_ids)","key":"TogRI8fT6X"},{"type":"outputs","id":"--eSUM3hYWz4ZLVcfQe0s","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Snow-on site IDs: ['CRS1', 'CRS2', 'CRS3', 'CRS4', 'CRS5', 'CRS6', 'CRS7', 'DEC', 'CRE']\nSnow-off site IDs: ['CRS1', 'CRS2', 'CRS3', 'CRS4', 'CRS5', 'CRS6', 'CRS7', 'DEC', 'CRE']\n"},"key":"qqeTJ5dyIB"}],"key":"SFhDdkkCJB"}],"identifier":"d8921f25-f09b-4e90-8d1f-4bbe7da8b4d5","html_id":"d8921f25-f09b-4e90-8d1f-4bbe7da8b4d5","key":"VmpWXyIxTq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Add site ID to attributes of DataArrays\nfor r, site in zip(snow_on_rasters, snon_site_ids):\n    r.attrs['site_id'] = site\n\nfor r, site in zip(snow_off_rasters, snoff_site_ids):\n    r.attrs['site_id'] = site","key":"YM74wfe7Aa"},{"type":"outputs","id":"9HaT4eISc0OfN44dFsrOV","children":[],"key":"wY6XJ5CfxM"}],"identifier":"00163878-ba4e-40e8-8946-e3ce577d09ef","html_id":"00163878-ba4e-40e8-8946-e3ce577d09ef","key":"Xtv0kKA9UW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create dictionaries linking each DataArray to a site ID\nsnow_on_dict = {r.attrs['site_id']: r for r in snow_on_rasters}\nsnow_off_dict = {r.attrs['site_id']: r for r in snow_off_rasters}","key":"lPcgm39qCL"},{"type":"outputs","id":"AoMnDLfGcHOR6o_V9ROXw","children":[],"key":"mHpcjooAtd"}],"identifier":"1bf7b98a-5a7c-4148-a1e2-73f158ba192e","html_id":"1bf7b98a-5a7c-4148-a1e2-73f158ba192e","key":"WzLXLyxqcP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now each TLS scan is linked to a site ID. However, we can see that the snow-on data has many more scans than the snow-off data. Because snow depth data is our priority, we will only consider snow-on scans that share a site ID with the snow-off data.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nlV9kAisOB"}],"key":"VCTLsduiKQ"}],"identifier":"4c16ff67-7cdf-4b9d-9180-4bdd55eadafa","html_id":"4c16ff67-7cdf-4b9d-9180-4bdd55eadafa","key":"GlROtq8wOO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Determine site IDs with recorded data for both snow-off and snow-on season\ncommon_site_ids = sorted(set(snow_on_dict).intersection(snow_off_dict))\nprint(\"Common site IDs:\", common_site_ids)","key":"sMu9axZr6x"},{"type":"outputs","id":"e6PF4OjEVxkjvPwe2BaVy","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Common site IDs: ['CRE', 'CRS1', 'CRS2', 'CRS3', 'CRS4', 'CRS5', 'CRS6', 'CRS7', 'DEC']\n"},"key":"xfu0IRa2Mk"}],"key":"x56fSIhaeO"}],"identifier":"c974690a-e98e-47f5-92e5-b69e3a809e69","html_id":"c974690a-e98e-47f5-92e5-b69e3a809e69","key":"mTeeIRJj4J"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create lists of DataArrays for the common sites only\nsnow_on_paired = [snow_on_dict[sid] for sid in common_site_ids]\nsnow_off_paired = [snow_off_dict[sid] for sid in common_site_ids]","key":"xAaeL6Iwl1"},{"type":"outputs","id":"cOCDYxj_S-GeBNYDWqwYK","children":[],"key":"PkLQPEGHB1"}],"identifier":"79cfc391-1bb3-4f45-9b25-243de16d7aae","html_id":"79cfc391-1bb3-4f45-9b25-243de16d7aae","key":"cCTVZuowQy"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that the site IDs are matched, deriving snow depth is the same as the first example, only with looping to make the calculation (and plotting) easier.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rQzA5QaT3J"}],"key":"GG1BtVu3bM"}],"identifier":"fb7d82db-3bf8-4ddc-85fb-d8e7f4b5d812","html_id":"fb7d82db-3bf8-4ddc-85fb-d8e7f4b5d812","key":"aDhKOWHhj9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"snow_depths = []\n# Interpolate DataArrays and derive snow depth, as before\nfor so, soff, site in zip(snow_on_paired, snow_off_paired, common_site_ids):\n    # Interpolate snow-on data onto the x/y grid of snow-off data\n    tmp_interp = so.interp(\n        x=soff.x,\n        y=soff.y,\n    )\n\n    tmp_diff = tmp_interp - soff\n    tmp_diff.attrs['site_id'] = site\n\n    tmp_diff = tmp_diff.where((tmp_diff[0]>0)&(tmp_diff[0]<=2))\n    snow_depths.append(tmp_diff)","key":"hlDLiX7jSB"},{"type":"outputs","id":"vs0cOX4WCAwYaZQKZycVm","children":[],"key":"ejdMjv574a"}],"identifier":"730b2bac-c565-4d57-a36d-5c497bb37315","html_id":"730b2bac-c565-4d57-a36d-5c497bb37315","key":"vDtC9Pf8fY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot the derived snow depths in a 3x3 figure\nfig, axes = plt.subplots(3, 3, figsize=(12, 12))\naxes = axes.flatten()\n\nfor idx, data_array in enumerate(snow_depths):\n    data_array.plot(ax=axes[idx], vmin=0, vmax=2)\n    axes[idx].set_title(f\"{snow_depths[idx].attrs['site_id']}\")\n\nplt.tight_layout()\nplt.show()","key":"pD2yW2ZEFh"},{"type":"outputs","id":"b7SNrVT5qwh-RawwfkJSk","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1200x1200 with 18 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"aa7aa15d0f4abe487c73ae5e1ef17222","path":"/snow-observations-cookbook/build/aa7aa15d0f4abe487c73ae5e1ef17222.png"}}},"key":"kv06NVyjIj"}],"key":"xqfXPGeJJk"}],"identifier":"cf471833-7362-4dec-a7d1-22cc0d4c8ef1","html_id":"cf471833-7362-4dec-a7d1-22cc0d4c8ef1","key":"R9xhZRfbOU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"That’s all there is to it! Some of the coverage is a bit sparse, and the depths over some sites look variable, but we have reasonable snow depths over 9 sites in Bonanza Creek. These could then be compared to other ground based efforts or airborne data to cross-calibrate observation methods.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"K22jJLA9Fv"}],"key":"OojrThM2bj"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Working with the Full Dataset Using earthaccess","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EGo2bELpSU"}],"identifier":"working-with-the-full-dataset-using-earthaccess","label":"Working with the Full Dataset Using earthaccess","html_id":"working-with-the-full-dataset-using-earthaccess","implicit":true,"key":"etyMXAxQM6"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This tutorial uses a subset of TLS data hosted on S3 for convenience and to avoid authentication requirements in automated builds. If you want to access the complete dataset from NSIDC or explore additional dates and locations, you can use the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Fi0IEeEKOj"},{"type":"inlineCode","value":"earthaccess","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"S3q5FsLZ8Z"},{"type":"text","value":" package.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Ft5wIRIuce"}],"key":"mVXFXSIH8T"},{"type":"heading","depth":4,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Installation","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"gxEdOUJPR6"}],"identifier":"installation","label":"Installation","html_id":"installation","implicit":true,"key":"UP102o11fy"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"First, install earthaccess if you haven’t already:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Kab94vGfBg"}],"key":"MXUDRNnV8Z"},{"type":"code","lang":"bash","value":"pip install earthaccess","position":{"start":{"line":11,"column":1},"end":{"line":13,"column":1}},"key":"j91UukOjkU"},{"type":"pa